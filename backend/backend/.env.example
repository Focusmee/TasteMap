# Backend 环境变量示例（复制为 .env 后按需修改）

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=6666667MySQL
DB_NAME=smart-softwear

# ===== 服务端口 =====
PORT=3000

# AMAP Web Service Key (backend REST API)
AMAP_WEB_KEY= 62dcda7f84789a38e32f7e6c9f7f82bf

# ===== 模型服务（FastAPI）地址 =====
# 如果你把模型服务跑在同一台机器：
MODEL_BASE=http://127.0.0.1:8008

# 如果模型服务在远程服务器，需要通过 SSH 端口转发到本机时：
# MODEL_BASE=http://127.0.0.1:8008

# 是否启用 HTTPS（true/false）
HTTPS=false
